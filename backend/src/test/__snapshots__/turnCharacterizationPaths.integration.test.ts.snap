    },
    {
      "description": "Searches the user's past chats (inside a project, that project's chats) for a few words. Returns matching excerpts with the chat's id, title and date, and a page_token to open each one with read_conversation. Use short keywords, never a pasted passage.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "max_results": {
            "description": "Results to return, 1 to 10. Defaults to 5.",
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
          },
          "query": {
            "description": "A few keywords.",
            "type": "string",
          },
          "within_conversation_id": {
            "description": "Search inside this one chat only.",
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
      "name": "conversation_search",
    },
    {
