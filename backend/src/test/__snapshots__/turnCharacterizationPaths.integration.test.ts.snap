          "series": {
            "description": "Required. One or more data series.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "color": {
                  "description": "Optional hex colour, only when the data has a meaningful colour.",
                  "type": "string",
                },
                "name": {
                  "description": "Optional. The series name; given, a legend is drawn.",
                  "type": "string",
                },
                "points": {
