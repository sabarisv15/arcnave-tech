                  "log",
                ],
                "type": "string",
              },
              "title": {
                "description": "Optional. The axis title, usually its units. Only when needed to read the chart.",
                "type": "string",
              },
            },
            "type": "object",
          },
          "y_axis": {
            "additionalProperties": false,
            "description": "Optional. Settings for the vertical axis.",
