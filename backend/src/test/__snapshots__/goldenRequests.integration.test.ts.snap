            "content": [
              {
                "text": "[This PDF has 2 pages. Images are sent for 2 of them (pages 1, 2), chosen for this question; only those pages’ text follows. Code can open the whole file.]",
                "type": "text",
              },
              {
                "text": "["policy.pdf" page 1 of 2, fileId: <uuid-1>]",
                "type": "text",
              },
              {
                "source": {
                  "data": "<text 7be4d8964c9e274a (131964 chars)>",
                  "media_type": "image/jpeg",
                  "type": "base64",
                },
                "type": "image",
              },
              {
                "text": "Text of page 1:
Leave policy: 18 days of earned leave.",
                "type": "text",
              },
              {
                "text": "["policy.pdf" page 2 of 2, fileId: <uuid-1>]",
                "type": "text",
              },
