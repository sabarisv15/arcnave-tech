                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "values": {
                  "description": "The values of a line or bar series, one per x label. Omit for scatter.",
                  "items": {
                    "type": "number",
                  },
                  "type": "array",
                },
              },
              "type": "object",
            },
            "type": "array",
          },
