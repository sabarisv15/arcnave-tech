                  "type": "string",
                },
                "url": {
                  "description": "Absolute https URL of the product page. Omit when you do not have a real one; never make one up.",
                  "type": "string",
                },
              },
              "required": [
                "name",
                "attributes",
              ],
              "type": "object",
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array",
          },
          "summary": {
            "description": "One short sentence (under 15 words) naming what the card shows, read when the card cannot be drawn. Do not repeat the card's values. Write it last.",
            "type": "string",
          },
        },
        "required": [
          "products",
          "summary",
        ],
        "type": "object",
      },
      "name": "comparison_card_display_v0",
    },
    {
      "description": "Searches the user's past chats (inside a project, that project's chats) for a few words. Returns matching excerpts with the chat's id, title and date, and a page_token to open each one with read_conversation. Use short keywords, never a pasted passage.",
      "inputSchema": {
