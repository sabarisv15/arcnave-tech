# ArcNave — environment template.
#
#   cp .env.example .env
#
# Copy this, fill in what you need, and never commit the result. `.env` is gitignored;
# `.env.example` is not, so nothing below may ever contain a real value.
#
# Only two variables have no default and will stop the stack from starting: POSTGRES_PASSWORD
# and COOKIE_SECRET. Everything else degrades honestly — with no Vertex configuration the app
# runs and reports every model as unavailable with the reason, rather than failing at the
# first message.
#
# WHERE THE FILE GOES. This template serves two workflows that read from two places:
#
#   docker compose   reads ./.env          (this directory)
#   npm run dev      reads ./backend/.env  (via --env-file-if-exists in package.json)
#
# The variable names are identical, so one template covers both — but a value set in one does
# not reach the other. If you run both, copy this to both paths. There is deliberately no
# second template: two files for one set of names is how they drift apart.

# ============================================================================ required

# Any strong value. Used by both the database container and the backend's connection string.
POSTGRES_PASSWORD=

# Signs the session cookie. At least 32 characters; the backend refuses to boot in production
# with anything shorter. Generate one with:
#   openssl rand -base64 48
COOKIE_SECRET=

# ============================================================================ serving

# Host port for the app. The API is not published; nginx proxies /v1 to it internally.
PORT=8080

# --- Running locally over plain HTTP -----------------------------------------
# A Secure cookie is silently dropped by the browser over http://, so with the production
# defaults you can register and then find yourself signed out. For a localhost trial set both
# of these. Do NOT ship them:
#
#   NODE_ENV=development
#   SESSION_COOKIE_SECURE=false
#
# --- Deploying behind TLS ----------------------------------------------------
# Leave NODE_ENV at its default of `production` and set your real origin below. CORS_ORIGINS
# cannot be `*` in production; the backend refuses to start if it is.
#
# CORS_ORIGINS=https://arcnave.example.com
# SESSION_COOKIE_SECURE=true

LOG_LEVEL=info

# Set false to close POST /auth/register with a typed `registration_closed` error — for
# single-account testing periods where sign-ups should not be open. Default true.
REGISTRATION_ENABLED=true

# ============================================================================ Vertex AI (Gemini)

# Absent, Gemini reports `vertex_not_configured` and the composer says so.
# Credentials come from Application Default Credentials — workload identity on GCP, or
# `gcloud auth application-default login` locally with the mount in compose.yaml uncommented.
# A service-account key file is never committed and never pasted into this file.
GOOGLE_CLOUD_PROJECT=

# Vertex endpoint for Gemini. Change only if data residency requires it.
VERTEX_LOCATION=global
# Optional. Gemini 3.8 Flash is global-only.
GEMINI_LOCATION=

# ============================================================================ Claude API

# Claude Sonnet 5.5 and Opus 5.5 go through the first-party Claude API (ADR-0054), not Vertex.
# SECRET: put the key in backend/.env (npm run dev) or ./.env (docker compose), both ignored by
# git. Never commit it, never paste it into a tracked file. Absent, the Claude aliases report
# `anthropic_not_configured`; in production, naming MODEL_SONNET/MODEL_OPUS without it fails boot.
ANTHROPIC_API_KEY=

# ============================================================================ Models (ADR-0055)

# Exactly three models. Gemini's id must be enabled in your Vertex project; unset means
# unavailable, never guessed. The Claude ids default to the first-party ids
# (docs.claude.com/en/docs/about-claude/models); an empty value turns that alias off.
MODEL_GEMINI_FLASH=gemini-3.8-flash
MODEL_SONNET=claude-sonnet-5-5
MODEL_OPUS=claude-opus-5-5

# Gate search and research. With both false those modes are unavailable and say why; ordinary
# chat still works.
ENABLE_GOOGLE_SEARCH_GROUNDING=false
ENABLE_ANTHROPIC_WEB_SEARCH=false

# Master gate for provider prompt caching (prefix stability & cache_control). Default false.
ENABLE_PROMPT_CACHE=true

# Path on your machine to the ADC file, if you uncommented the mount in compose.yaml.
# Linux/macOS: ~/.config/gcloud/application_default_credentials.json
# Windows:     %APPDATA%\gcloud\application_default_credentials.json
# GOOGLE_ADC_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=/var/secrets/adc.json

# ============================================================================ pricing

# USD per million tokens, per provider model ID. A model with no entry reports cost as null —
# meaning "no price configured" — and never as 0, which would read as free. Each call also
# stores its rupee cost beside the dollar cost (cost_usd and cost_inr): the dollar cost times
# PRICING_INR_PER_USD below. No dollar price means no rupee price.
#
# Seed rates from docs/architecture/Stage-18-Cost-Performance/00-checkpoint-stage18.md (the
# keys are the provider model ids the registry uses):
#   claude-sonnet-5-5  $2 in / $10 out / $0.10 cache read / $2.50 cache write (5-minute)
#                      (doc-sync 2026-10-10, first-party Claude API, read 2026-10-10)
#   claude-opus-5-5    $4 in / $20 out / $0.20 cache read / $5 cache write (5-minute)
#                      (same doc-sync; the 1-hour write rates, $4 and $8, are not used)
#   gemini-3.8-flash   $1.50 in / $7.50 out / $0.15 cache read: the LIST rate (N-36, FD-20).
#                      Owner decision 2026-10-15, worst-case planning rule: the list rate is
#                      used now. The 2026 promo ($0.75 / $3.75 / $0.075 through 2026-12-31) is
#                      booked as a separate 50 % credit, not as a lower price, so no cost is
#                      under-stated (doc-sync 2026-10-11 prices a call this way too).
#                      PRICING_TABLE has NO effective-date mechanism; nothing needs changing
#                      on 2027-01-01 now, but a later rate change is still a by-hand edit
#                      (and a restart), or costs before and after will be wrong.
#                      cacheWrite is 0 because Gemini bills no per-token cache write; the
#                      explicit-cache storage charge ($1 per 1M token-hours) is not modelled
#                      by this schema, and gemini.ts never reports a cache-write count.
PRICING_TABLE={"gemini-3.8-flash":{"input":1.50,"output":7.50,"cacheRead":0.15,"cacheWrite":0},"claude-sonnet-5-5":{"input":2,"output":10,"cacheRead":0.10,"cacheWrite":2.50},"claude-opus-5-5":{"input":4,"output":20,"cacheRead":0.20,"cacheWrite":5}}

# Rupees per US dollar for the rupee figure beside every dollar cost. 88 is the planning rate
# of the Stage 18 cost decision log (N-37), not an invoice rate. Leave empty to use the default
# in backend/src/config/numbers.ts. A cost stored earlier keeps the rate it was stored with.
PRICING_INR_PER_USD=88

# ============================================================================ storage

# `local` writes to the `uploads` volume. `gcs` needs STORAGE_GCS_BUCKET and the
# @google-cloud/storage package installed in the deployment that uses it.
STORAGE_BACKEND=local
STORAGE_GCS_BUCKET=

# ============================================================================ database

POSTGRES_USER=arcnave
POSTGRES_DB=arcnave

# ============================================================================ edge and platform (ADR-0065)

# Proxies in front of the backend that append to X-Forwarded-For. The client address (rate-limit
# bucket for signed-out requests) is the entry this many hops from the right; anything the client
# wrote further left is ignored. 1 = Cloud Run's front end. In docker compose, nginx is the one hop.
# 0 = trust no header. Never more than the real number of proxies.
TRUST_PROXY_HOPS=1

# Swagger UI at /docs. Leave unset: on in development, off when NODE_ENV=production. Set true or
# false to override in any environment.
# DOCS_ENABLED=

# Outbound fetch of user-chosen URLs (web_fetch, grounding redirects): body ceiling in bytes,
# redirects followed (each re-checked), and the whole-fetch deadline (N-43: 10 s).
# SAFE_FETCH_MAX_BYTES=5242880
# SAFE_FETCH_MAX_REDIRECTS=3
# Grounding citations follow longer redirect chains; every hop is still checked.
# SAFE_FETCH_GROUNDING_MAX_REDIRECTS=8
# One connect attempt before the host's next checked address is tried (IPv4 first).
# SAFE_FETCH_CONNECT_TIMEOUT_MS=3000
# SAFE_FETCH_TIMEOUT_MS=10000

# Only for the Cloud Run Job sandbox engine with SANDBOX_STAGE_BUCKET: the service account that
# signs staging URLs (sandbox-invoker@<your-project>.iam.gserviceaccount.com). No default in code.
# SANDBOX_SIGNING_SA=

# ============================================================================ P13 helpers (ADR-0080)

# The helper model for the title, history-summary and router-shadow jobs: Claude Haiku 5.5 on
# the first-party Claude API (needs ANTHROPIC_API_KEY). Never a chat model, never in /models,
# never a fallback. Empty turns the helper jobs off; they are then skipped with a coded log
# line, never run on another model. Price rows for Haiku come with the price book (P22): until
# then a helper call's cost is null (unknown), never 0.
# MODEL_HAIKU=claude-haiku-5-5

# Rolling history summary (N-77) and the Normal input budget (N-03 48k). On by default; it
# replaces the old compaction (ENABLE_CONTEXT_COMPACTION is ignored while this is on).
# Set false to roll back to the compaction.
# ENABLE_HISTORY_SUMMARY=true
# Ours, pending the owner: a turn older than the newest 6 is dropped only once a summary covers
# it. false = the stage rule (newest 6 turns only).
# HISTORY_KEEP_UNCOVERED=true

# Router M2 shadow call (N-69): logs its decision, never changes the route. Off until the intent
# list exists (owner item).
# ROUTER_SHADOW=false
