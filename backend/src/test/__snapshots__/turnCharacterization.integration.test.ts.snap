                "snippet": {
                  "description": "Optional one or two sentences on why the link is relevant.",
                  "type": "string",
                },
                "title": {
                  "description": "Page title (one line, under about 80 characters).",
                  "type": "string",
                },
                "url": {
                  "description": "Absolute http(s) URL the card opens.",
                  "type": "string",
                },
              },
              "required": [
                "url",
                "title",
              ],
              "type": "object",
            },
            "maxItems": 6,
