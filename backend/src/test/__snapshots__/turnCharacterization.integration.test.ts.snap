          "title": {
            "description": "Short heading for the trip ('3 days in Tokyo'). One line.",
            "type": "string",
          },
        },
        "required": [
          "days",
          "summary",
        ],
        "type": "object",
      },
      "name": "itinerary_display_v0",
    },
    {
      "description": "Shows 1 to 6 web links as preview cards with title, site and an optional snippet. Use it for outside pages the user should open: search results, citations or further reading that back your answer ("find me articles on X", "where can I read more").

Do not use it for content in the chat itself, for one incidental link (put it in the text), for more than six (pick the best six), or for any entry without a real absolute http(s) URL: never make up a link; drop that entry.

Keep titles to one line and snippets to one or two sentences. Do not list the URLs again in your text.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "links": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "domain": {
                  "description": "Optional site name ('Wirecutter'). Taken from the URL when omitted.",
                  "type": "string",
