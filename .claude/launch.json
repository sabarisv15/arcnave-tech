{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "arcnave-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "arcnave-frontend"],
      "port": 5173
    },
    {
      "name": "arcnave-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "backend"],
      "port": 8080
    },
    {
      "name": "audit-docs",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "docs/audits"],
      "port": 8765
    }
  ]
}
