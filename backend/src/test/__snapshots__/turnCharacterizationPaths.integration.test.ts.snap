    },
    {
      "description": "Deletes a whole memory file. Only when the user asks to forget that file or subject; to remove one line, use memory_str_replace. Never delete to tidy up. Needs the version from a memory_read of the file. A delete cannot be undone.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "if_version": {
            "description": "The version token from your memory_read of this file.",
