                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "blurb": {
                        "description": "Optional. One short line on what to do or expect.",
                        "type": "string",
                      },
                      "name": {
                        "description": "The place or activity (a few words).",
                        "type": "string",
                      },
                      "time": {
                        "description": "Optional. A time or a rough slot ('9:00 AM', 'Afternoon').",
                        "type": "string",
                      },
                    },
                    "required": [
