# Frontend configuration. Copy to `.env.local`; never commit real values.
# Both settings are optional — the defaults work against a backend on 127.0.0.1:8080.

# Where the dev server proxies `/v1`. Change this if the backend runs elsewhere.
VITE_API_PROXY=http://127.0.0.1:8080

# Where the browser sends API calls. Leave unset to use the same-origin `/v1` path, which is
# what keeps the session cookie first-party. Set an absolute URL only if the API is served from
# a different origin in production — the backend's CORS_ORIGINS must then list this app's origin.
# VITE_API_BASE=https://api.example.com/v1
