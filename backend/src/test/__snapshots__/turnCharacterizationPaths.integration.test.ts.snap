    },
    {
      "description": "Creates a new file with the given content, making its folders. Fails when the path already exists: edit an existing file with str_replace, or overwrite it with bash_tool.",
      "inputSchema": {
        "properties": {
          "description": {
            "description": "Why this file is being created. Give this first.",
