    },
    {
      "description": "Returns what show_widget needs: the theme's CSS variables and colours, typography, layout rules and examples for a kind of visual. Call it before your first show_widget call, and again later for a different module. It is a setup step: do not mention or narrate it; go straight on to the visual.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "modules": {
            "description": "Which modules to load. Pick all that fit.",
            "items": {
              "enum": [
                "diagram",
                "mockup",
                "interactive",
                "data_viz",
                "art",
                "chart",
                "elicitation",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "platform": {
            "description": "'mobile' when the person is on a narrow (~380px) screen, so sizes suit it; otherwise 'desktop'. Defaults to 'unknown' (desktop sizing).",
            "enum": [
              "mobile",
              "desktop",
              "unknown",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "read_me",
    },
    {
      "description": "Reads the indexed text of one project file by id, starting at an optional cursor, for when a search excerpt is not enough context. The response is bounded and may be truncated — check \`truncated\` and pass the returned \`nextCursor\` back in a follow-up call to continue reading. Only call this with a fileId already seen in this conversation, such as one returned by search_project_files. Do not guess a fileId.",
      "inputSchema": {
