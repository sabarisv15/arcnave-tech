              },
              "required": [
                "day_label",
                "stops",
              ],
              "type": "object",
            },
            "maxItems": 7,
            "minItems": 1,
            "type": "array",
          },
          "summary": {
            "description": "One short sentence (under 15 words) naming what the card shows, read when the card cannot be drawn. Do not repeat the card's values. Write it last.",
            "type": "string",
          },
          "title": {
            "description": "Short heading for the trip ('3 days in Tokyo'). One line.",
            "type": "string",
          },
        },
        "required": [
