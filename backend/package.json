{
  "name": "arcnave-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sandbox-image": "bash sandbox/test/run-integration-tests.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "openapi": "tsx src/openapi.ts",
    "eval:prompt": "tsx --env-file-if-exists=.env scripts/evalPrompt.ts",
    "conformance:live": "tsx --env-file-if-exists=.env scripts/conformanceLive.ts",
    "kit:table": "tsx scripts/kitTable.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.22.0",
    "@node-rs/argon2": "^2.2.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.1.0",
    "heic-decode": "^2.1.0",
    "image-size": "^1.2.1",
    "officeparser": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "jszip": "^3.10.2",
    "pino-pretty": "^13.1.2",
    "puppeteer-core": "^25.11.0",
    "regenerator-runtime": "^0.13.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.1"
  }
}
