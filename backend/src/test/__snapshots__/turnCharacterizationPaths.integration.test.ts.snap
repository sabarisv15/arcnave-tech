          },
          "title": {
            "description": "Optional. Shown above the chart.",
            "type": "string",
          },
          "x_axis": {
            "additionalProperties": false,
            "description": "Optional. Settings for the horizontal axis.",
            "properties": {
              "data": {
                "description": "Optional labels, one per value of every series (dates, names, buckets).",
