        "type": "object",
      },
    },
    {
      "description": "Searches the user's past chats (inside a project, that project's chats) for a few words. Returns matching excerpts with the chat's id, title and date, and a page_token to open each one with read_conversation. Use short keywords, never a pasted passage.",
      "name": "conversation_search",
      "parametersJsonSchema": {
        "additionalProperties": false,
        "properties": {
          "max_results": {
            "description": "Results to return, 1 to 10. Defaults to 5.",
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
          },
          "query": {
            "description": "A few keywords.",
            "type": "string",
          },
          "within_conversation_id": {
            "description": "Search inside this one chat only.",
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
    },
    {
      "description": "Opens a past chat at a conversation_search hit and returns the turns around it. Not for reading whole chats.",
      "name": "read_conversation",
      "parametersJsonSchema": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "description": "The chat id from a tool result. Never guess one.",
            "type": "string",
          },
          "max_turns": {
            "description": "Turns to return, up to 50. Defaults to 20.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
          },
          "page_token": {
            "description": "A hit's page_token, or next_page_token / prev_page_token. Omit to start at the beginning.",
            "type": "string",
          },
        },
        "required": [
          "conversation_id",
        ],
        "type": "object",
      },
    },
    {
      "description": "Lists the user's most recently updated chats (inside a project, that project's), newest first, with a short excerpt of each. Page with before and after.",
      "name": "recent_chats",
      "parametersJsonSchema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "Only chats updated after this ISO date-time.",
